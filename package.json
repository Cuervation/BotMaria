{
  "name": "movistar-arena-watchdog",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic Playwright watchdog for Movistar Arena dates.",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "monitor": "ts-node --transpile-only src/index.ts",
    "test": "node --test",
    "list-audio-devices": "powershell.exe -ExecutionPolicy Bypass -File scripts/set-speakers.ps1 -ListAudioDevices"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "playwright": "^1.54.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}

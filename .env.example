# URL inicial. Puede quedar vacío si preferís navegar manualmente.
MONITOR_URL=

TARGET_ARTIST=María Becerra
TARGET_DAY_REGEX=^2\d$
CHECK_INTERVAL_MS=30000

ALARM_YOUTUBE_URL=https://www.youtube.com/watch?v=Terd4qKkb6k
ALARM_COOLDOWN_MINUTES=60

PLAYWRIGHT_USER_DATA_DIR=.playwright-profile
STATE_DIR=state

# Login automático liviano:
# 1) Hace click en "Iniciar sesión"
# 2) Hace click en "Ingresar"
# No escribe usuario ni password. Usa lo que ya esté precargado/guardado.
LOGIN_ENABLED=true
LOGIN_START_TEXT=Iniciar sesión
LOGIN_SUBMIT_TEXT=Ingresar
LOGIN_WAIT_MS=3000
POST_LOGIN_WAIT_MS=5000

# Fila virtual / waiting room:
# El bot puede detectar, esperar y continuar cuando el sitio habilite controles normales.
# No debe intentar evadir captcha ni romper protecciones técnicas del sitio.
QUEUE_MONITOR_ENABLED=true
QUEUE_CONTINUE_WHEN_AVAILABLE=true

# Compra asistida:
# Permite que Codex implemente PurchaseAssistAgent para clickear el botón configurado
# cuando DateDetectorAgent detecta una fecha válida 20-29 disponible.
PURCHASE_ASSIST_ENABLED=true
PURCHASE_CLICK_ENABLED=true
PURCHASE_BUTTON_TEXT=Comprar
PURCHASE_FALLBACK_BUTTON_TEXT=Seleccionar
PURCHASE_ACTION_COOLDOWN_MINUTES=60

# Audio / parlantes en Windows
FORCE_SPEAKERS=true
SPEAKER_DEVICE_NAME=Altavoces
FORCE_SYSTEM_VOLUME=true
SPEAKER_SCRIPT_PATH=scripts/set-speakers.ps1
